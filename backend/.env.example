# =====================================================================
#  TS SPORTS — Variables de entorno del backend (Laravel)
#  ---------------------------------------------------------------------
#  Copia este fichero a ".env" y rellena los valores reales.
#  El fichero .env NUNCA se sube al repositorio: contiene contraseñas.
#
#  Después de crearlo, genera la clave de cifrado de la aplicación:
#      php artisan key:generate
# =====================================================================

APP_NAME="TS Sports"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Caracas
# Dominio desde el que se sirve la API. Debe llevar https en producción
# o las URLs de las imágenes saldrán mal.
APP_URL=https://tssports.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# ---------------------------------------------------------------------
# Base de datos MySQL
# ---------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tsports
DB_USERNAME=tsports
DB_PASSWORD=

# ---------------------------------------------------------------------
# Cuenta de administrador inicial
# ---------------------------------------------------------------------
# La crea "php artisan db:seed". Es la primera cuenta con la que se
# entra al panel; cámbiale la contraseña nada más iniciar sesión.
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@tssports.com
ADMIN_PASSWORD=CambiaEstaClave2026

# ---------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------
# Orígenes autorizados a llamar a la API desde un navegador, separados
# por comas. En producción, con nginx sirviendo todo desde el mismo
# dominio, esto ni llega a usarse; hace falta en desarrollo.
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------
# Sesiones, caché y colas
# ---------------------------------------------------------------------
# La autenticación va por token (Sanctum), así que la sesión de servidor
# apenas se usa. "database" evita depender de ficheros compartidos si
# algún día hay más de un servidor.
SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# Duración del token de acceso, en minutos. 10080 = 7 días: cómodo para
# el equipo sin dejar sesiones abiertas indefinidamente.
SANCTUM_TOKEN_MINUTES=10080

# ---------------------------------------------------------------------
# Registro de errores
# ---------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ---------------------------------------------------------------------
# Correo (opcional; hoy el sistema no envía correos)
# ---------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@tssports.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# Tiempo real (Reverb)
# ---------------------------------------------------------------------
# Credenciales del propio servidor Reverb, no de un servicio externo: se
# inventan al instalar (openssl rand -hex 16 sirve). El frontend no las
# lleva compiladas: pide la clave a GET /api/tiempo-real, así que viven
# solo aquí.
#
# OJO al rellenarlas: con BROADCAST_CONNECTION=reverb y
# REVERB_APP_KEY/SECRET/ID vacíos, CUALQUIER comando de artisan falla al
# arrancar (Laravel construye el cliente de Reverb durante el boot, no
# solo al usarlo). Rellena las tres antes de tocar nada más con artisan.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# REVERB_SERVER_HOST/PORT: dónde escucha `artisan reverb:start`. Solo en
# 127.0.0.1, nunca expuesto a internet: el navegador entra por el propio
# dominio y nginx lo reenvía (location /app/), así que no hay que abrir
# ningún puerto en el cortafuegos.
#
# REVERB_HOST/PORT/SCHEME: a dónde PUBLICA el backend. Es el mismo
# proceso, por dentro de la máquina, así que va la misma dirección y
# por http aunque el sitio vaya por HTTPS. NO es el dominio público:
# nginx solo reenvía /app/ (lo del navegador), no /apps/ (lo que publica
# el backend), y un evento mandado por fuera no llegaría nunca.
#
# Dos instalaciones en la misma máquina (producción y test) necesitan
# un puerto cada una: cambia los dos a la vez.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

BROADCAST_CONNECTION=reverb

# ---------------------------------------------------------------------
# Avisos al móvil (push del navegador)
# ---------------------------------------------------------------------
# Par de claves VAPID de ESTA instalación. Producción y test tienen las
# suyas; no se comparten ni se copian de una a otra.
#
#   php artisan push:claves
#
# y se pegan aquí las dos líneas que imprime. Vacías, el push queda
# apagado y el resto del sistema funciona igual: los avisos siguen
# llegando a la campanita, que es donde se guardan de verdad.
#
# CAMBIARLAS DESPUÉS deja sin avisos a todos los dispositivos que ya los
# aceptaron —sus suscripciones están firmadas con la anterior— y hay que
# volver a aceptarlos uno a uno. Se generan una vez y se dejan quietas.
#
# La PÚBLICA viaja al navegador y no es secreta. La PRIVADA firma cada
# envío y no sale del servidor.
#
# El push necesita además el trabajador de colas (tsports-queue): el
# envío no va dentro de la petición.
VAPID_SUBJECT=https://tsports.tech
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
