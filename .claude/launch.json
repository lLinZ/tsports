{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5173
    },
    {
      "name": "frontend-compilado",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--prefix", "frontend", "--", "--port", "4173", "--strictPort"],
      "port": 4173
    },
    {
      "name": "backend",
      "runtimeExecutable": "php",
      "runtimeArgs": ["backend/artisan", "serve", "--host=127.0.0.1", "--port=8000"],
      "port": 8000
    }
  ]
}
